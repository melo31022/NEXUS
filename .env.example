# Optional legacy configuration. Prefer /setup inside NEXUS for encrypted Windows DPAPI storage.
# Keep this file private and never commit it.
# NEXUS 1.1 uses hosted cloud providers only. No local model inference.
NEXUS_PROVIDER=ollama

# Interface language: auto (detect Windows/user locale), pt or en.
NEXUS_LANGUAGE=auto

# Ollama Cloud — Beam is the default model.
# Create an API key in your Ollama account.
OLLAMA_API_KEY=
OLLAMA_MODEL=beam

# Optional: comma-separated model IDs known to accept images.
# Beam is text-only, so it must not be included here.
# OLLAMA_VISION_MODELS=model-a,model-b

# Groq Cloud
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Additional OpenAI-compatible cloud providers (optional)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Optional image-capable model IDs; only enable models verified by your provider.
# OPENROUTER_VISION_MODELS=
# CEREBRAS_VISION_MODELS=
# TOGETHER_VISION_MODELS=
# DEEPSEEK_VISION_MODELS=

# Optional runtime limits
NEXUS_MAX_STEPS=18
NEXUS_REQUEST_TIMEOUT=75
NEXUS_MAX_CONTEXT_TOKENS=16000
NEXUS_MAX_OUTPUT_TOKENS=2048
NEXUS_MAX_TOOL_CALLS_PER_STEP=6
