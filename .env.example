# Copy this file to .env. Keep .env private and never commit it.
# NEXUS 1.0 uses cloud providers only: ollama or groq.
NEXUS_PROVIDER=ollama

# Interface language: auto (detect Windows/user locale), pt or en.
NEXUS_LANGUAGE=auto

# Ollama Cloud — Beam is the default model.
# Create an API key in your Ollama account.
OLLAMA_API_KEY=
OLLAMA_MODEL=beam

# Optional: comma-separated model IDs known to accept images.
# Beam is text-only, so it must not be included here.
# OLLAMA_VISION_MODELS=model-a,model-b

# Groq Cloud
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional runtime limits
NEXUS_MAX_STEPS=18
NEXUS_REQUEST_TIMEOUT=75
